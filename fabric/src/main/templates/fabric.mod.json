{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "sources": "${mod_url}"
  },
  "license": "${mod_license}",
  "icon": "assets/customcursor/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "fr.atesab.customcursormod.fabric.FabricCursorMod"
    ],
    "modmenu": [
      "fr.atesab.customcursormod.fabric.compat.ModMenuImpl"
    ]
  },
  "mixins": [
    "customcursor.mixins.json",
    "customcursor.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": "${loader_version_range}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=21",
    "fabric-api": "${fapi_version_range}",
    "modmenu": ">=16.0.0-rc.1"
  }
}
